{
  "collections": {
    "products": {
      "primaryKey": "id",
      "fields": {
        "id": "string",
        "name": "string",
        "category": "earrings | sunglasses | necklace",
        "price": "number",
        "currency": "string",
        "thumbnailUrl": "string",
        "tryOnImageUrl": "string",
        "modelUrl": "string",
        "arSupported": "boolean"
      }
    },
    "users": {
      "primaryKey": "id",
      "fields": {
        "id": "string",
        "email": "string",
        "displayName": "string",
        "createdAt": "ISO datetime string"
      }
    },
    "wishlists": {
      "primaryKey": "userId",
      "fields": {
        "userId": "string",
        "productIds": "string[]",
        "updatedAt": "ISO datetime string"
      }
    },
    "tryOns": {
      "primaryKey": "id",
      "fields": {
        "id": "string",
        "userId": "string",
        "userEmail": "string | null",
        "productId": "string",
        "accessoryId": "string",
        "faceRatio": "number | null",
        "earlobeDistance": "number | null",
        "earlobeLength": "number | null",
        "fps": "number | null",
        "sessionId": "string | null",
        "trackingStatus": "Started | Calibrating | Tracking | Camera blocked | null",
        "createdAt": "ISO datetime string"
      }
    },
    "susResponses": {
      "primaryKey": "id",
      "fields": {
        "id": "string",
        "userId": "string",
        "answers": "number[10]",
        "score": "number",
        "comments": "string",
        "createdAt": "ISO datetime string"
      }
    }
  }
}
