{
  "name": "aura-ar",
  "private": true,
  "version": "0.1.0",
  "description": "AuraAR - AR Virtual Try-On for Accessories (Monorepo)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "backend": "cd backend && npm run start",
    "backend:dev": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "seed:firebase": "cd backend && npm run seed:firebase",
    "seed:products": "cd backend && npm run seed:products",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "dependencies": {
    "firebase": "^12.15.0"
  }
}
